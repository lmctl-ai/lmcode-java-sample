# The host dispatches @item for each Money and @total for the total.
# Adjuster is declared by the schema as (Money) -> void.
schema = load_schema(schema="../sample-suite/sample.dsl.json");
program = _lmcode_ schema;
@item
fn item_tag(m: Money) -> void implements Adjuster {
  print("item rule " + str(m.amount()));
}
@item
fn item_audit(m: Money) -> void implements Adjuster {
  print("audit " + str(m.amount()));
}
@total
fn total_tag(m: Money) -> void implements Adjuster {
  print("total rule " + str(m.amount()));
}
@never
fn never_called(m: Money) -> void implements Adjuster {
  print("MUST NOT PRINT");
}
print("body done");
end _lmcode_
result = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
require(result.ok, "host failed");
