import "./sample-suite/runner-lib.lms";
root = suite_root();
fn step(command) {
  result = invoke(suite_root(), command, [], {}, 1800000);
  print(result.stdout);
  print(result.stderr);
  assert(result.code == 0 && result.error == "", "test step failed: " + json_stringify(command) + " " + result.error);
}
python = "python3";
if (env("RUNNER_OS") == "Windows") { python = "python"; }
step([python, "-B", "scripts/sync.py", "check"]);
step(["bash", "scripts/build-jvm.sh"]);
jvm = ["java", "-jar", path_join(Directory, "target/lmcode-java-sample.jar")];
step(concat(compiler_command(), ["--no-preflight", "sample-suite/audit.lms", "--std", "vendor/lmcode-java/std/lmcode-std.schema.json"]));
step(concat(compiler_command(), ["--no-preflight", "sample-suite/run-suite.lms"], jvm));
step(concat(compiler_command(), ["--no-preflight", "sample-suite/check-recompile.lms"]));
step(concat(compiler_command(), ["--no-preflight", "sample-suite/test-runner.lms"]));
step(concat(compiler_command(), ["--no-preflight", "examples/rule-entries.lms", path_join(Directory, "build/rule-entries.dslb")]));
expected = binary(root, {op:"hex", path:path_join(root, "expected/068-rule-entries.out")});
fn example(command, expected) {
  r = invoke(suite_root(), command, ["--dsl", path_join(Directory, "build/rule-entries.dslb")], {}, 30000);
  assert(r.code == 0 && r.hex == expected && r.stderr_hex == "", "annotated interface example differs");
}
example(jvm, expected);
if (env("RUN_NATIVE") == "1") {
  step(["bash", "scripts/build-native.sh"]);
  executable = path_join(Directory, "build/lmcode-java-sample");
  if (env("RUNNER_OS") == "Windows") { executable = executable + ".exe"; }
  step(concat(compiler_command(), ["--no-preflight", "sample-suite/run-suite.lms", executable]));
  example([executable], expected);
  println("PASS GraalVM native executable");
}
println("PASS annotated interface example");

# Small standalone text-template example, in addition to the shared corpus.
mkdir("build");
template_bytecode = path_join(Directory,"build/text-template.dslb");
step(concat(compiler_command(),["--no-preflight","examples/text-template.lms",template_bytecode]));
template_result = invoke(root,jvm,["--dsl",template_bytecode],{},30000);
assert(template_result.code == 0 && template_result.stderr_hex == "" && template_result.stdout == "Hello, Sam!\nItems: 0: apple, 1: pear\n{\"ok\": true, \"result\": {\"balance\": 0, \"entries\": 0, \"note\": \"\", \"entries_called\": 0}}\n","text template example differs");
println("PASS text template example");
