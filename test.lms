import "./sample-suite/runner-lib.lms";
root = suite_root();
fn step(command) {
  result = invoke(suite_root(), command, [], {}, 1800000);
  print(result.stdout);
  print(result.stderr);
  assert(result.code == 0 && result.error == "", "test step failed: " + json_stringify(command) + " " + result.error);
}
python = "python3";
if (env("RUNNER_OS") == "Windows") { python = "python"; }
step([python, "-B", "scripts/sync.py", "check"]);
step(["bash", "scripts/build-jvm.sh"]);
step([python, "scripts/test-dry-invocations.py", path_join(Directory, "bin/lmcode-java-sample")]);
jvm = ["java", "-jar", path_join(Directory, "target/lmcode-java-sample.jar")];
step(concat(compiler_command(), ["sample-suite/audit.lms", "--std", "vendor/lmcode-java/std/lmcode-std.schema.json"]));
step(concat(compiler_command(), ["sample-suite/run-suite.lms"], jvm));
step(concat(compiler_command(), ["sample-suite/check-recompile.lms"]));
step(concat(compiler_command(), ["sample-suite/test-runner.lms"]));
example_host = path_join(Directory, "bin/lmcode-java-sample");
if (env("RUN_NATIVE") == "1") {
  step(["bash", "scripts/build-native.sh"]);
  example_host = path_join(Directory, "build/lmcode-java-sample");
  if (env("RUNNER_OS") == "Windows") { example_host = example_host + ".exe"; }
  step(concat(compiler_command(), ["sample-suite/run-suite.lms", example_host]));
  println("PASS GraalVM native executable");
} else {
  assert(env("RUNNER_OS") != "Windows", "RUN_NATIVE=1 is required for Windows host discovery");
}
step([python, "scripts/check-invocations.py", example_host]);
step([python, "scripts/test-invocation-mutations.py"]);
rule_example = invoke(suite_root(), concat(compiler_command(), ["examples/rule-entries.lms", example_host]), [], {}, 30000);
assert(rule_example.code == 0 && rule_example.stdout == "body done\nitem rule 125\nitem rule 250\nitem rule 375\naudit 125\naudit 250\naudit 375\ntotal rule 750\n{\"host_summary\":{\"balance\": 0, \"entries\": 0, \"note\": \"\", \"entries_called\": 7}}\n" && rule_example.stderr_hex == "", "annotated interface example differs");
println("PASS annotated interface example");
# The reusable text-template program runs through the public API and the selected host.
template_result = invoke(suite_root(), concat(compiler_command(), ["examples/text-template.lms", example_host]), [], {}, 30000);
assert(template_result.code == 0 && template_result.stderr_hex == "" && template_result.stdout == "Hello, Sam!\nItems: 0: apple, 1: pear\n{\"host_summary\":{\"balance\": 0, \"entries\": 0, \"note\": \"\", \"entries_called\": 0}}\n", "text template example differs");
println("PASS text template example");
